# Server
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/avrum
MONGODB_DB_NAME=avrum

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Password Hashing
PASSWORD_PEPPER=optional-password-pepper-change-in-production
BCRYPT_ROUNDS=12

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Email
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# AWS S3 (for file uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=avrum-uploads

# External Services
OPENWEATHER_API_KEY=
AI_SERVICE_URL=http://localhost:5000
AI_SERVICE_TOKEN=ai-service-secret-token

# Observability
SENTRY_DSN=
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=1000
RATE_LIMIT_WINDOW_MS=60000

# API Key Management
API_KEY_HASH_SECRET=api-key-hash-secret-change-in-production

# Webhook
WEBHOOK_SIGNING_ALGO=sha256
